    "db:seed-khtn9": "cd backend && npm run seed-khtn9",
    "package:release": "node scripts/package-release.mjs",
    "test:security": "node scripts/security-gate.mjs",
    "pilot:monitor": "node scripts/monitor-pilot.mjs",
    "pilot:load": "cd backend && node scripts/v5-load-test.mjs"
  }
}
