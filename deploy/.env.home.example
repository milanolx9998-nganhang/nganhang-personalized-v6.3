APP_PROFILE=home-supabase
DATABASE_PROVIDER=supabase
STORAGE_PROVIDER=supabase
NODE_ENV=production
DOMAIN=bank.home.internal
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
CORS_ORIGIN=https://bank.home.internal
# Dedicated HOME database. Do not use School DB or School secret.
DATABASE_URL=
JWT_SECRET=
SUPABASE_URL=http://api-gw:8000
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_DIR=/data/import-temp
BACKUP_DIR=/data/backups

# ---- Hiệu năng (PERF V6.6.7) — xem docs/PERF_V6_6_7_REDIS_SUPAVISOR.md ----
# Redis tùy chọn: bỏ trống REDIS_URL thì không dùng cache / bộ đếm chung, app vẫn chạy.
REDIS_URL=redis://redis:6379
REDIS_PREFIX=ngh:home
REDIS_CACHE_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
# Pool kết nối của MỖI tiến trình Node. Tổng = số tiến trình × DB_POOL_MAX, phải nằm trong ngân sách Supavisor.
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_MS=5000
SLOW_QUERY_MS=250
# Trần rate limit theo IP. Cả trường đi ra Internet qua MỘT IP (NAT) thì cả lớp chung trần này — đo bằng
# GET /api/practice/operations/client-ip trước khi chỉnh. Giới hạn theo tài khoản giữ nguyên.
RATE_LIMIT_LOGIN_IP=50
RATE_LIMIT_API_IP=3000
RATE_LIMIT_API_USER=300
